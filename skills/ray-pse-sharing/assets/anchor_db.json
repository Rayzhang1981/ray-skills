{
 "_meta": {
  "name": "ray-pse-sharing 历史事故锚点数据库",
  "version": "2.0.0",
  "updated": "2026-08-29",
  "design_principles": [
   "1. 首要任务是扩库：尽量涵盖各类事故类型（特别是工艺安全），量足够大才能『快速定位直接应用』",
   "2. 典型性三条款：a.影响大较为知名 b.与事故类型适配 c.新事故优于旧事故（特别出名的经典除外）",
   "3. 毕业机制=典型性复审而非使用次数上限：重要事故允许反复使用（事故分享就是反复揣摩学习，事故中成长）；不满足典型性的 → retired 淘汰"
  ],
  "tier_rules": {
   "S": "经典知名事故（重大伤亡/社会影响/教科书案例），不限使用次数，跨类型优先",
   "A": "典型行业事故（本类型首选池）",
   "B": "补充案例（同类不足时选用；复审不达标淘汰）"
  },
  "lifecycle": "pending(未核实,不得入卡) -> active(可用) -> retired(典型性复审不通过)",
  "usage": "python anchor_db.py pick <类型> --dir <卡目录> --from N --to M | scan-cards <卡目录> | review <id> --retire --reason | verify <id> | add --file x.json | search 关键词 | stats",
  "known_gaps": [
   "导热油炉/锅炉炉膛爆炸（锚点库TODO 2-3条）",
   "受限空间动火残料更多经典",
   "应急处置/盲目施救专题分组"
  ]
 },
